# ============================================================================
# Purple Festival Gujarat 2027 — Apache Routing & Security Rules (.htaccess)
# Bluehost Apache 2.4 + cPanel Native Compatible (no bare php_flag directives)
# ============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# Prevent Apache mod_dir from issuing 301 trailing-slash redirects on POST requests to directory routes
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# Block direct HTTP access to sensitive, configuration, documentation, backup & database files
<FilesMatch "(^(\.env|\.pfg27_env|\.user\.ini|composer\.(json|lock)|package(-lock)?\.json|README\.md)$|\.(sql|sqlite|sqlite3|db|log|md|yml|yaml|bak|old|orig|swp|tsbuildinfo)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(), camera=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct HTTP access to internal, audit, documentation, test & script directories and hidden dotfiles
    RewriteRule ^(database|includes|docs|audit|project-docs|tests|scripts|data|node_modules)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 2. Enforce HTTPS on all non-localhost hosts (Bluehost staging & production)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 3. Explicit clean route mappings for core pages & portals
    RewriteRule ^$ index.php [QSA,L]
    RewriteRule ^login/?$ login.php [QSA,L]
    RewriteRule ^auth/login/?$ auth/login.php [QSA,L]
    RewriteRule ^programme/?$ programme.php [QSA,L]
    RewriteRule ^accessibility/?$ accessibility.php [QSA,L]
    RewriteRule ^apply/?$ apply/index.php [QSA,L]
    RewriteRule ^dashboard/?$ dashboard/index.php [QSA,L]
    RewriteRule ^dashboard/pass-print/?$ dashboard/pass-print.php [QSA,L]
    RewriteRule ^admin/?$ admin/index.php [QSA,L]
    RewriteRule ^rgst/?$ rgst/index.php [QSA,L]
    RewriteRule ^legal/privacy/?$ legal/privacy.php [QSA,L]
    RewriteRule ^legal/terms/?$ legal/terms.php [QSA,L]
    RewriteRule ^legal/accessibility-statement/?$ legal/accessibility-statement.php [QSA,L]

    # 4. Explicit clean route mappings for JSON API endpoints
    RewriteRule ^api/registrations/?$ api/registrations/index.php [QSA,L]
    RewriteRule ^api/checkins/?$ api/checkins/index.php [QSA,L]
    RewriteRule ^api/checkins/confirm/?$ api/checkins/confirm.php [QSA,L]
    RewriteRule ^api/coupons/validate/?$ api/coupons/validate.php [QSA,L]
    RewriteRule ^api/qr/verify/?$ api/qr/verify.php [QSA,L]
    RewriteRule ^api/qr/pass/?$ api/qr/pass.php [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/qr/([A-Za-z0-9_-]+)/?$ api/qr/pass.php?registrationId=$1 [QSA,L]

    # 5. Serve existing static assets and files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 6. Resolve extensionless URLs to matching <path>/index.php if directory exists
    RewriteCond %{REQUEST_FILENAME}/index.php -f
    RewriteRule ^(.+?)/?$ $1/index.php [QSA,L]

    # 7. Resolve extensionless URLs to matching <path>.php file (e.g. /api/auth/login -> api/auth/login.php)
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [QSA,L]
</IfModule>
