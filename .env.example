# ==============================================================================
# Purple Festival Gujarat 2027 — Environment Configuration Template
# Copy to .env.local for development or configure in your hosting platform.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- Database (PostgreSQL) ---
# Production: postgresql://user:password@host:5432/purple_festival_gujarat_2027?sslmode=require
# Local zero-daemon PostgreSQL (PGlite): leave DATABASE_URL unset or set PGLITE_DATA_DIR
DATABASE_URL=
PGLITE_DATA_DIR=./data/pgdata

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Security & Cryptography (Generate with: openssl rand -hex 32) ---
AUTH_SECRET=replace-with-64-char-random-hex-secret
QR_SIGNING_SECRET=replace-with-64-char-random-hex-secret

# --- Superadmin Bootstrap (One-time secure initialization) ---
# Used only by `npm run db:bootstrap-superadmin` when no Superadmin exists
SUPERADMIN_BOOTSTRAP_EMAIL=
SUPERADMIN_BOOTSTRAP_PASSWORD=
SUPERADMIN_BOOTSTRAP_NAME=Festival Superadmin

# --- Email Delivery (Resend / SMTP — Optional; queued locally if unconfigured) ---
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="Purple Festival Gujarat 2027 <noreply@purplefestivalgujarat.com>"

# --- Payments (Razorpay — Disabled unless all three are configured) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Private Object Storage (S3-compatible — Optional; local private dir fallback) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

